FROM node:22-bookworm-slim

ARG AGENTSKIN_GIT_COMMIT=unknown
LABEL org.opencontainers.image.title="agentskin-core-eval"
LABEL org.opencontainers.image.revision=$AGENTSKIN_GIT_COMMIT

ENV NODE_ENV=production

WORKDIR /app

COPY agentskin/package.json agentskin/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts

COPY agentskin/backend ./backend
COPY agentskin/scripts/sparse-env-core-eval.mjs ./scripts/sparse-env-core-eval.mjs

CMD ["node", "scripts/sparse-env-core-eval.mjs"]
