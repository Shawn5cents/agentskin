{
  "name": "agentskin",
  "version": "5.1.0",
  "description": "Context middleware for AI agents: prune API and JSON responses and compact CLI output before it enters model context.",
  "type": "module",
  "main": "backend/mcp.js",
  "bin": {
    "agentskin": "backend/mcp.js"
  },
  "files": [
    "backend/mcp.js",
    "backend/lib/",
    "suite/",
    "README.md",
    "USAGE.md",
    "LICENSE",
    "PROJECT_STATE.md"
  ],
  "scripts": {
    "start": "node backend/mcp.js",
    "test": "vitest run tests",
    "test:watch": "vitest",
    "lint": "eslint backend/mcp.js backend/lib/ benchmarks/run.js tests/ --ext .js",
    "lint:fix": "eslint backend/mcp.js backend/lib/ benchmarks/run.js tests/ --fix --ext .js",
    "benchmark": "node benchmarks/run.js",
    "prepublishOnly": "node scripts/prepublish.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.1",
    "axios": "^1.20.0",
    "cheerio": "^1.0.0",
    "tokenjuice": "^0.8.5",
    "zod": "^3.24.2"
  },
  "keywords": [
    "mcp",
    "agentic",
    "perception",
    "semantic",
    "token-optimization",
    "ai-agents"
  ],
  "author": "Shawn Nichols Sr. (Nichols Transco LLC)",
  "license": "MIT",
  "devDependencies": {
    "@dqbd/tiktoken": "^1.0.22",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.5.0",
    "prettier": "^3.8.3",
    "vitest": "^4.1.5"
  }
}
